# FMP keys, used in order; a key is skipped for the rest of the UTC day after a 429.
FMP_API_KEY_1=your_primary_fmp_key_here
FMP_API_KEY_2=
FMP_API_KEY_3=
FMP_API_KEY_4=

# Offline development: answer every FMP request from local fixtures (no key, no quota).
# FMP_FIXTURE_DIR=tests/fixtures/fmp

# Extra allowed browser origins (comma separated) and the preview-deployment regex.
# ALLOWED_ORIGINS=https://your-domain.example
# ALLOWED_ORIGIN_REGEX=https://valuation-tool[a-z0-9-]*\.vercel\.app

# Per-IP limit on /api/valuation (requests per window). One report page = 4 requests.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW=60
# Reverse proxies in front of the app that append to X-Forwarded-For (1 on Render).
# Leave 0 when not behind a proxy, otherwise every user shares one rate-limit bucket.
# TRUSTED_PROXY_HOPS=0

# Statement / peer-list cache lifetime in seconds (prices are always 1 hour).
# STATEMENT_CACHE_TTL=86400
